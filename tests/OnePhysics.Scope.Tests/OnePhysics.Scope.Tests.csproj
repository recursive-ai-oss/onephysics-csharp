<Project Sdk="Microsoft.NET.Sdk">

  <!-- Not in the solution and not built by CI: the module needs the OneScope SDK package (see src/OnePhysics.Scope/README.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>RecursiveAI.OnePhysics.Scope.Tests</AssemblyName>
    <RootNamespace>RecursiveAI.OnePhysics.Scope.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ONESCOPE_SDK_FEED)' != ''">
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(ONESCOPE_SDK_FEED)</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OnePhysics.Scope/OnePhysics.Scope.csproj" />
  </ItemGroup>

</Project>
