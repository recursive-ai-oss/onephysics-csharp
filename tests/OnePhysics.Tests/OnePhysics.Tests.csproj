<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>RecursiveAI.OnePhysics.Tests</AssemblyName>
    <RootNamespace>RecursiveAI.OnePhysics.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Tiered compilation off: with it on, the runtime compiles on-stack-replacement versions on the calling thread and installs optimized code from a background thread, and both allocate a few
         hundred bytes to kilobytes inside the runtime at moments that depend on timing. The allocation tests count every thread, so they would count that (see WarmAllocationTests). -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Common/Services3DScene.cs" LinkBase="Common" />
    <Compile Include="../Common/SoftBodies3DScene.cs" LinkBase="Common" />
    <Compile Include="../Common/Characters3DScene.cs" LinkBase="Common" />
    <Compile Include="../Common/Vehicles3DScene.cs" LinkBase="Common" />
    <Compile Include="../Common/VehicleKinds3DScene.cs" LinkBase="Common" />
    <Compile Include="../Common/Ragdolls3DScene.cs" LinkBase="Common" />
  </ItemGroup>

  <!-- Minimised inputs that once made a fuzz target fail; FuzzRegressionTests replays them. -->
  <ItemGroup>
    <Content Include="../../README.md" Link="readme/README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../ReadmeExamples/Quickstart*.cs" Link="readme/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../ReadmeExamples/Guide/*.cs" Link="readme/Guide/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/guide/*.md" Link="readme/guide/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../testdata/api/*.txt" Link="api/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../testdata/fuzz/**" Link="fuzz-regress/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OnePhysics/OnePhysics.csproj" />
    <ProjectReference Include="../ReadmeExamples/ReadmeExamples.csproj" />
    <ProjectReference Include="../../fuzz/Fuzz/Fuzz.csproj" />
  </ItemGroup>

</Project>
