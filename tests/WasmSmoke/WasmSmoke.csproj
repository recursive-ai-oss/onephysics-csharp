<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the smoke program on browser WebAssembly under Node (see main.mjs). It will also host the cross-platform hash rows. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>WasmSmoke</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <WasmNativeStrip>false</WasmNativeStrip>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Common/SmokeProgram.cs" LinkBase="Common" />
    <Compile Include="../Common/Services3DScene.cs" LinkBase="Common" />
    <Compile Include="../Common/Characters3DScene.cs" LinkBase="Common" />
    <Compile Include="../Common/Vehicles3DScene.cs" LinkBase="Common" />
    <Compile Include="../Common/VehicleKinds3DScene.cs" LinkBase="Common" />
    <Compile Include="../Common/Ragdolls3DScene.cs" LinkBase="Common" />
    <Compile Include="../OnePhysics.Tests/Collision3D/Collision3DHash.cs" LinkBase="Common" />
    <Compile Include="../OnePhysics.Tests/Collision3D/TestRng.cs" LinkBase="Common" />
    <Compile Include="../OnePhysics.Tests/Broadphase/BroadphaseHash.cs" LinkBase="Common" />
    <ProjectReference Include="../../src/OnePhysics/OnePhysics.csproj" />
  </ItemGroup>

</Project>
