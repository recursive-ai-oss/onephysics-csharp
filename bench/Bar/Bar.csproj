<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bar runner: scene generator, stability metrics, and the harness that drives the reference engines.
       Comparison libraries are referenced here and nowhere else. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Bar</AssemblyName>
    <RootNamespace>Bar</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Every managed engine measured here (ours and the in-process references) runs fully optimised code from its first call. With tiered compilation a 600-step scene of a small world ends before
         the hot methods leave their unoptimised first tier, and the row measures the JIT, not the engine: chain 0.47 ms against 0.03 ms. The native references have no such phase. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Box2D.NET" Version="3.1.654" />
    <PackageReference Include="BepuPhysics" Version="2.5.0-beta.33" />
    <PackageReference Include="Jitter2" Version="2.13.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OnePhysics/OnePhysics.csproj" />
  </ItemGroup>

</Project>
