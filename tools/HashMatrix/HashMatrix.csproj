<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The hash-matrix runner. Scenarios live under Scenarios/ and register themselves; the same project is
    built as a normal console app, published with NativeAOT (-p:PublishAot=true) and built for
    browser-wasm (-r browser-wasm) by tools/hash-matrix.sh.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OnePhysics.HashMatrix</RootNamespace>
    <AssemblyName>HashMatrix</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CA1051: the linked scene definitions in bench/Bar are plain data classes with public fields; the runner is a tool, not part of the package. -->
    <NoWarn>$(NoWarn);CS1591;CA1051</NoWarn>
    <WasmNativeStrip>false</WasmNativeStrip>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup><Compile Include="../../tests/Common/RodScenes.cs" LinkBase="Common" /><Compile Include="../../tests/Common/PulleyScenes.cs" LinkBase="Common" /></ItemGroup>
  <ItemGroup>
    <Compile Include="../../tests/Common/FieldScenes.cs" LinkBase="Common" />
    <Compile Include="../../tests/Common/ContactSurfaceScene.cs" LinkBase="Common" />
    <EmbeddedResource Include="../../testdata/replay/*.oppr" LogicalName="replay.%(Filename)" />
    <ProjectReference Include="../../src/OnePhysics/OnePhysics.csproj" />
    <ProjectReference Include="../../src/OnePhysics.Tools/OnePhysics.Tools.csproj" />
    <Compile Include="../../tests/Common/ToolsMeshes.cs;../../tests/Common/DecomposedPileScene.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/TetBlob.cs;../../tests/Common/TestSkeleton.cs;../../tests/Common/TetDropScene.cs;../../tests/Common/AutoRagdollScenes.cs" LinkBase="Checks" />
    <!-- The batching experiment's simulation code (not its command-line program) is hashed here. -->
    <Compile Include="../../experiments/batching/Sim/*.cs" LinkBase="Batching" />
    <!-- Existing determinism checks and the shared scene definitions, linked from where they live. -->
    <Compile Include="../../tests/OnePhysics.Tests/Collision3D/Collision3DHash.cs;../../tests/OnePhysics.Tests/Collision3D/TestRng.cs;../../tests/OnePhysics.Tests/Broadphase/BroadphaseHash.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/Services3DScene.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/SoftBodies3DScene.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/SoftBodies2DScene.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/SoftFracture3DScene.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/Cloth3DScene.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/FluidScenes.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/Strip2DScene.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/SoftSkinned3DScene.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/Characters3DScene.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/CharacterAbilityScenes3D.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/TerrainEditScenes.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/CharacterAbilityScenes2D.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/Vehicles3DScene.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/Vehicles2DScene.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/RailBikeScenes2D.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/RailBikeScenes3D.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/Actuators3DScene.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/Actuators2DScene.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/WaterScenes.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/SwimScenes.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/VehicleKinds3DScene.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/Ragdolls3DScene.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/Walkers3DScene.cs" LinkBase="Checks" />
    <Compile Include="../../tests/Common/DestructionScenes.cs" LinkBase="Checks" />
    <Compile Include="../../bench/Bar/Scene.cs;../../bench/Bar/Gen.cs;../../bench/Bar/Gen3.cs;../../bench/Bar/GenMachines.cs;../../bench/Bar/SceneBuilder2D.cs;../../bench/Bar/SceneBuilder3D.cs;../../bench/Bar/SoftGen.cs;../../bench/Bar/SleeveRig.cs" LinkBase="Scenes" />
  </ItemGroup>

</Project>
