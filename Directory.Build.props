<Project>

  <PropertyGroup>
    <!-- The package id derives from this single property pair. -->
    <PackagePrefix>RecursiveAI</PackagePrefix>
    <PackageBaseName>$(PackagePrefix).OnePhysics</PackageBaseName>
    <!-- The one place the package version lives. -->
    <Version>0.1.0-preview.5</Version>
    <Authors>Recursive AI, LLC</Authors>
    <Company>Recursive AI, LLC</Company>
    <Copyright>Copyright (c) Recursive AI, LLC</Copyright>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/recursive-ai-oss/onephysics-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/recursive-ai-oss/onephysics-csharp</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <Configurations>Debug;Release;Checked;Profile</Configurations>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Floating-point results must never depend on the JIT's choices. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <!-- Reproducible packages: path mapping applies to the library only (src/), and only on CI. Test projects keep real paths. -->
  <PropertyGroup>
    <_ProjectDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)'))</_ProjectDir>
    <_SrcDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'src'))</_SrcDir>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' and $(_ProjectDir.StartsWith('$(_SrcDir)'))">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Build output never lands in the checkout: set ONEPHYSICS_ARTIFACTS to choose where it goes. -->
  <PropertyGroup>
    <OnePhysicsHome Condition="'$(HOME)' != ''">$(HOME)</OnePhysicsHome>
    <OnePhysicsHome Condition="'$(OnePhysicsHome)' == ''">$(USERPROFILE)</OnePhysicsHome>
    <ArtifactsPath Condition="'$(ONEPHYSICS_ARTIFACTS)' != ''">$(ONEPHYSICS_ARTIFACTS)</ArtifactsPath>
    <ArtifactsPath Condition="'$(ONEPHYSICS_ARTIFACTS)' == ''">$(OnePhysicsHome)/.cache/onephysics-artifacts</ArtifactsPath>
  </PropertyGroup>

  <!-- onemath comes from nuget.org once published; until then tools/localfeed.sh copies it into the ignored .localfeed/ directory. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory).localfeed')">
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory).localfeed</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!-- The raw tier (RecursiveAI.OnePhysics.LowLevel) is marked [Experimental("OPHYS0001")] and the 3D engine (RecursiveAI.OnePhysics.Physics3D) [Experimental("OPHYS0002")] for consumers. Our own tests, benchmarks and tools use it on purpose; the package itself and the README examples do not suppress it. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'OnePhysics' And '$(MSBuildProjectName)' != 'ReadmeExamples'">
    <NoWarn>$(NoWarn);OPHYS0001;OPHYS0002</NoWarn>
  </PropertyGroup>

  <!-- Checked: Release optimisations plus bounds-checked internal accessors (CHECKED). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Checked'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <DefineConstants>$(DefineConstants);CHECKED</DefineConstants>
  </PropertyGroup>
  <!-- Profile: Release plus the stage boundaries of a step (STAGE_TIMERS), for the benchmark runner's per-stage tables. Never packed. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Profile'">
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);STAGE_TIMERS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>
