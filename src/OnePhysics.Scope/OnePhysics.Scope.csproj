<Project Sdk="Microsoft.NET.Sdk">

  <!-- The physics module for the family viewer, built against the OneScope SDK. It is not in the solution and CI does not build it. The
       release workflow builds, tests and packs it on a scope-v<version> tag. See README.md in this folder for the build command. -->
  <PropertyGroup>
    <AssemblyName>$(PackageBaseName).Scope</AssemblyName>
    <RootNamespace>RecursiveAI.OnePhysics.Scope</RootNamespace>
    <PackageId>$(PackageBaseName).Scope</PackageId>
    <Version>1.1.1</Version>
    <Description>The RecursiveAI.OnePhysics module for the OneScope viewer: opens OnePhysics replays, snapshots and scenes in 2D and 3D, and lets the viewer play, seek, fork, diff and inspect them.</Description>
    <PackageTags>physics;replay;viewer;deterministic;determinism;onescope</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <!-- Each pack is checked against the last published release of the module, so a break for its users fails the pack. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.1.0</PackageValidationBaselineVersion>
    <NoWarn>$(NoWarn);OPHYS0001</NoWarn>
  </PropertyGroup>

  <!-- Optional: a folder or feed to restore the SDK package from instead of nuget.org, given as ONESCOPE_SDK_FEED (environment or -p:). -->
  <PropertyGroup Condition="'$(ONESCOPE_SDK_FEED)' != ''">
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(ONESCOPE_SDK_FEED)</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE-MIT" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../LICENSE-APACHE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RecursiveAI.OnePhysics" Version="1.0.0" />
    <PackageReference Include="RecursiveAI.OneScope.Sdk" Version="1.0.0" />
  </ItemGroup>

</Project>
