<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>$(PackageBaseName).Interchange</AssemblyName>
    <RootNamespace>RecursiveAI.OnePhysics.Interchange</RootNamespace>
    <PackageId>$(PackageBaseName).Interchange</PackageId>
    <Description>Importers for RecursiveAI.OnePhysics: URDF and MJCF robots become articulation definitions, glTF physics extensions become 3D scenes, Tiled and LDtk maps become 2D tile grids and bodies. Hostile input is rejected with typed errors; the same bytes give the same definitions on every platform.</Description>
    <PackageTags>physics;urdf;mjcf;gltf;tiled;ldtk;import;collision;robotics;deterministic;determinism;nativeaot;trimmable</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See CHANGELOG.md in the repository.</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Packing compares the public API with the last published release and fails on a break. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <!-- Importers produce definitions of the 3D engine, whose types are marked experimental for consumers; inside this package they are simply used. -->
    <NoWarn>$(NoWarn);OPHYS0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="../../LICENSE-MIT" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../LICENSE-APACHE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OnePhysics/OnePhysics.csproj" />
  </ItemGroup>

</Project>
