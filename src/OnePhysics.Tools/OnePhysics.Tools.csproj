<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>$(PackageBaseName).Tools</AssemblyName>
    <RootNamespace>RecursiveAI.OnePhysics.Tools</RootNamespace>
    <PackageId>$(PackageBaseName).Tools</PackageId>
    <Description>Authoring-time geometry for RecursiveAI.OnePhysics: 3D convex decomposition, hull simplification, mesh cleaning and mass properties, tetrahedralization and quality triangulation for soft bodies, ragdoll fitting from a skeleton, 2D polygon decomposition and sprite outlines. Deterministic on every platform.</Description>
    <PackageTags>physics;convex-decomposition;tetrahedralization;ragdoll;mesh;collision;polygon;sprite;deterministic;determinism;nativeaot;trimmable</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See CHANGELOG.md in the repository.</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- There is no published version to compare with yet; turn validation on at the first release. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <!-- Decomposition output is a compound shape of the 3D engine, whose types are marked experimental for consumers (OPHYS0002); inside this package they are simply used. -->
    <NoWarn>$(NoWarn);OPHYS0001;OPHYS0002;OPHYS0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="../../LICENSE-MIT" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../LICENSE-APACHE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OnePhysics/OnePhysics.csproj" />
  </ItemGroup>

</Project>
