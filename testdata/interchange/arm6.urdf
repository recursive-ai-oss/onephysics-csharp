<?xml version="1.0"?>
<!-- A six-joint arm written for the importer tests. -->
<robot name="arm6">
  <link name="base_link">
    <inertial><origin xyz="0 0 0.05" rpy="0 0 0"/><mass value="4"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.01"/></inertial>
    <collision><origin xyz="0 0 0.05" rpy="0 0 0"/><geometry><cylinder radius="0.1" length="0.1"/></geometry></collision>
    <visual><geometry><sphere radius="0.5"/></geometry></visual>
  </link>
  <link name="link1">
    <inertial><origin xyz="0 0 0.1"/><mass value="3"/><inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.01"/></inertial>
    <collision><origin xyz="0 0 0.1"/><geometry><box size="0.1 0.1 0.2"/></geometry></collision>
  </link>
  <link name="link2">
    <inertial><origin xyz="0 0 0.15"/><mass value="2.5"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.005"/></inertial>
    <collision><origin xyz="0 0 0.15"/><geometry><cylinder radius="0.04" length="0.3"/></geometry></collision>
  </link>
  <link name="link3">
    <inertial><origin xyz="0 0 0.125"/><mass value="2"/><inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.004"/></inertial>
    <collision><origin xyz="0 0 0.125"/><geometry><box size="0.08 0.08 0.25"/></geometry></collision>
  </link>
  <link name="link4">
    <inertial><origin xyz="0 0 0.05"/><mass value="1.2"/><inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.002"/></inertial>
    <collision><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.035" length="0.1"/></geometry></collision>
  </link>
  <link name="link5">
    <inertial><origin xyz="0 0 0.04"/><mass value="0.8"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/></inertial>
    <collision><origin xyz="0 0 0.04"/><geometry><box size="0.06 0.06 0.08"/></geometry></collision>
  </link>
  <link name="link6">
    <inertial><origin xyz="0 0 0.02"/><mass value="0.5"/><inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0004"/></inertial>
    <collision><origin xyz="0 0 0.04"/><geometry><sphere radius="0.04"/></geometry></collision>
  </link>
  <joint name="joint1" type="revolute"><parent link="base_link"/><child link="link1"/><origin xyz="0 0 0.1"/><axis xyz="0 0 1"/><limit lower="-3" upper="3" effort="50"/><dynamics damping="0.1" friction="0.01"/></joint>
  <joint name="joint2" type="revolute"><parent link="link1"/><child link="link2"/><origin xyz="0 0.05 0.2"/><axis xyz="0 1 0"/><limit lower="-1.5" upper="1.5" effort="50"/><dynamics damping="0.1" friction="0.01"/></joint>
  <joint name="joint3" type="revolute"><parent link="link2"/><child link="link3"/><origin xyz="0 0 0.3"/><axis xyz="0 1 0"/><limit lower="-2" upper="2" effort="30"/><dynamics damping="0.1" friction="0.01"/></joint>
  <joint name="joint4" type="revolute"><parent link="link3"/><child link="link4"/><origin xyz="0 0 0.25" rpy="1.5707963267948966 0 0"/><axis xyz="0 0 1"/><limit lower="-3" upper="3" effort="20"/><dynamics damping="0.05" friction="0.005"/></joint>
  <joint name="joint5" type="revolute"><parent link="link4"/><child link="link5"/><origin xyz="0 0 0.1"/><axis xyz="0 1 0"/><limit lower="-2" upper="2" effort="20"/><dynamics damping="0.05" friction="0.005"/></joint>
  <joint name="joint6" type="continuous"><parent link="link5"/><child link="link6"/><origin xyz="0 0 0.08"/><axis xyz="0 0 1"/><limit effort="10"/><dynamics damping="0.05" friction="0.005"/></joint>
</robot>
