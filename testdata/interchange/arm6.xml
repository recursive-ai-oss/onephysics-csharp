          <geom friction="0.6 0.005 0.0001" type="cylinder" size="0.04 0.15" pos="0 0 0.15"/>
          <body name="link3" pos="0 0 0.3">
            <joint name="joint3" type="hinge" axis="0 1 0" range="-2 2" damping="0.1" frictionloss="0.01"/>
            <inertial pos="0 0 0.125" mass="2" diaginertia="0.015 0.015 0.004"/>
            <geom friction="0.6 0.005 0.0001" type="box" size="0.04 0.04 0.125" pos="0 0 0.125"/>
            <body name="link4" pos="0 0 0.25" quat="0.7071067811865476 0.7071067811865476 0 0">
              <joint name="joint4" type="hinge" axis="0 0 1" range="-3 3" damping="0.05" frictionloss="0.005"/>
              <inertial pos="0 0 0.05" mass="1.2" diaginertia="0.006 0.006 0.002"/>
              <geom friction="0.6 0.005 0.0001" type="cylinder" size="0.035 0.05" pos="0 0 0.05"/>
              <body name="link5" pos="0 0 0.1">
                <joint name="joint5" type="hinge" axis="0 1 0" range="-2 2" damping="0.05" frictionloss="0.005"/>
                <inertial pos="0 0 0.04" mass="0.8" diaginertia="0.002 0.002 0.001"/>
                <geom friction="0.6 0.005 0.0001" type="box" size="0.03 0.03 0.04" pos="0 0 0.04"/>
                <body name="link6" pos="0 0 0.08">
                  <joint name="joint6" type="hinge" axis="0 0 1" damping="0.05" frictionloss="0.005"/>
                  <inertial pos="0 0 0.02" mass="0.5" diaginertia="0.0006 0.0006 0.0004"/>
                  <geom friction="0.6 0.005 0.0001" type="sphere" size="0.04" pos="0 0 0.04"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor joint="joint1" gear="1" forcerange="-50 50"/>
    <motor joint="joint2" gear="1" forcerange="-50 50"/>
    <motor joint="joint3" gear="1" forcerange="-30 30"/>
    <motor joint="joint4" gear="1" forcerange="-20 20"/>
    <motor joint="joint5" gear="1" forcerange="-20 20"/>
    <motor joint="joint6" gear="1" forcerange="-10 10"/>
  </actuator>
</mujoco>
