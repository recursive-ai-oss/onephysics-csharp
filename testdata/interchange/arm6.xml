<mujoco model="arm6">
  <!-- The same arm as arm6.urdf, written in MJCF for the importer tests. -->
  <compiler angle="radian"/>
  <worldbody>
    <body name="base_link" pos="0 0 0">
      <inertial pos="0 0 0.05" mass="4" diaginertia="0.02 0.02 0.01"/>
      <geom friction="0.6 0.005 0.0001" type="cylinder" size="0.1 0.05" pos="0 0 0.05"/>
