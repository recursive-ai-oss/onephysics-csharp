# Allowlist: everything is ignored unless listed here. Give each new top-level path its own line.
/*
!/.gitignore
!/.gitattributes
!/.github
!/LICENSE-MIT
!/LICENSE-APACHE
!/README.md
!/CONTRIBUTING.md
!/global.json
!/Directory.Build.props
!/nuget.config
!/OnePhysics.slnx
!/src
!/tests
!/fuzz
!/bench
!/tools
!/docs

# Build output never belongs in the tree, wherever it appears.
bin/
obj/
TestResults/
*.nupkg
