# Allowlist: everything is ignored unless listed here. Give each new top-level path its own line.
/*
!/.gitignore
!/.gitattributes
!/.github
!/LICENSE-MIT
!/LICENSE-APACHE
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/global.json
!/Directory.Build.props
!/nuget.config
!/OnePhysics.slnx
!/src
!/tests
!/fuzz
!/bench
!/tools
!/scenes
!/experiments
!/docs
!/testdata

# Build output never belongs in the tree, wherever it appears.
bin/
obj/
TestResults/
*.nupkg

# Generated scenes are rebuilt by `bar gen`; scenes/SHA256SUMS pins their bytes.
/scenes/generated/
